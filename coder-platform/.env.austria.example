NODE_ENV=production
HOST=0.0.0.0
PORT=3402
DATA_DIR=/app/data
PUBLIC_DIR=/app/public
PRIME_AGENT_BIN=prime-agent
ENGINE_ROOT_DIR=/app/engine-sessions
MOCK_ENGINE=false

# Agent model. The engine reads the provider key from the environment (see Prime Agent docs/providers.md).
# Leave the API key lines commented until a provider key is placed on the server. Never commit real keys.
PRIME_AGENT_PROVIDER=
PRIME_AGENT_MODEL=
ENGINE_TIMEOUT_MS=1800000
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=

# Platform operations (added 13 Sep 2026).
# PUBLIC_BASE_URL is used in emails so links point to the public site.
PUBLIC_BASE_URL=https://coder.sam.university
# /metrics answers only when METRICS_TOKEN matches. Set the real value on the server, never in git.
METRICS_TOKEN=
# Comma separated emails that always have platform admin rights.
PLATFORM_ADMIN_EMAILS=
# Guardrails per workspace. 0 means no limit. 20000000 micro-USD is 20 US dollars.
DEFAULT_DAILY_COST_LIMIT_MICROS=20000000
DEFAULT_MONTHLY_COST_LIMIT_MICROS=0
DEFAULT_RUNS_PER_HOUR_LIMIT=0
# Outgoing mail for verification and password reset. The platform reports EMAIL_NOT_CONFIGURED while these are empty.
# A mailbox must exist on the mail server. SMTP_USER is the full address; SMTP_FROM may add a display name.
# Working values for the mailcow on the Austria server (checked 13 Sep 2026, TLS 1.3, certificate mail.ilmupelet.com):
#   SMTP_HOST=mail.ilmupelet.com
#   SMTP_PORT=587
#   SMTP_SECURE=false      # 587 upgrades with STARTTLS; use SMTP_SECURE=true with port 465 instead
#   SMTP_FROM=COBLAI Coder <noreply@ilmupelet.com>
# ilmupelet.com already publishes SPF, DKIM and DMARC. coblai.com has no public MX, SPF or DKIM records,
# so mail sent as @coblai.com is likely to be refused or filed as spam until those records exist.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false

# Payment gateways (added 14 Sep 2026, v0.11.0). Keys live here, never in the database or the UI.
# The admin page can select manual transfer right away. Xendit or Midtrans turn on only when the
# matching key below is filled, otherwise the API answers GATEWAY_NOT_CONFIGURED.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
# Webhook base URL advertised to gateways. Empty means the platform reports it is not set yet.
PLATFORM_WEBHOOK_URL=
