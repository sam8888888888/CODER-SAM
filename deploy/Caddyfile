# Prime Agent Hub - Caddy reverse proxy (HTTPS otomatis + proteksi akses)
# Domain utama: coder.sam.university
# primeagent.farraha.com DIMATIKAN TOTAL 19 Agu 2026 (keputusan Papi) - DNS NXDOMAIN di Cloudflare
# Whitelist IP Papi (203.0.113.10) — bypass anti-bot & rate limit
# Rate limit per IP (plugin mholt/caddy-ratelimit)

coder.sam.university {
    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    # FIX (Rena 20 Agu 2026): cache aset statis supaya loading enteng (gzip sudah jalan)
    # index.html & API TIDAK di-cache (update langsung); aset statis 10 mnt; vendor/gambar 1 jam.
    @static path /app.js /styles.css /manifest.json /sw.js /favicon.png /favicon-32.png /icon-192.png /icon-512.png /apple-touch-icon.png
    header @static Cache-Control "public, max-age=600"
    @vendor path /vendor/*
    header @vendor Cache-Control "public, max-age=3600"
    @img path /images/* /workspace/*
    header @img Cache-Control "public, max-age=3600"
    @html path / /index.html /landing.html /daftar.html /thankyou.html /konfirmasi.html
    header @html Cache-Control "no-cache"

    @blocked {
        not header User-Agent *Mozilla*
        not path /api/telegram/webhook
        not path /api/whatsapp/webhook
        not remote_ip 203.0.113.10
    }
    respond @blocked 403

    rate_limit {
        zone dynamic {
            key {remote_host}
            events 30
            window 10s
            except 203.0.113.10
        }
    }

    respond "coder.sam.university sementara dimatikan" 503
}

videogenerator.sam.university {
    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    reverse_proxy videogenerator-dash:3700
}

myfunnel.sam.university {
    encode gzip
    @pubhelp path_regexp ^/bantuan(/.*)?$
    redir @pubhelp /login 308
    reverse_proxy myfunnel-app:3000
}

*.myfunnel.sam.university {
    encode gzip
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }
    reverse_proxy myfunnel-app:3000
}

# COBLAI - chat.coblai.com (Ayank 26 Agu 2026) - Coder's Omni Builder Labs (AI)
chat.coblai.com {
    encode gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Via
    }
    tls {
        ca https://acme-v02.api.letsencrypt.org/directory
    }
    @blocked path /.env* /.git* /.DS_Store /backup.zip
    respond @blocked 404
    reverse_proxy coblai-chat:3102
}

